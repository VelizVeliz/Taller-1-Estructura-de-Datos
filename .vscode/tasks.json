{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build Hospital (todas las clases)",
            "command": "g++",
            "args": [
                "-Wall",
                "-Wextra",
                "-g3",
                "${workspaceFolder}\\main.cpp",
                "${workspaceFolder}\\Clases\\Hospital.cpp",
                "${workspaceFolder}\\Clases\\Servicio.cpp",
                "${workspaceFolder}\\Clases\\LectorArchivo.cpp",
                "${workspaceFolder}\\Clases\\Paciente.cpp",
                "${workspaceFolder}\\Clases\\Persona.cpp",
                "-o",
                "${workspaceFolder}\\output\\main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compila main.cpp junto con Hospital, Servicio, LectorArchivo, Paciente y Persona. (Queue.cpp y Stack.cpp NO se agregan aqui: son plantillas y ya se incluyen solas desde Queue.h/Stack.h)."
        }
    ]
}